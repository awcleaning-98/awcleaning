# Security headers for Netlify

# Clickjacking protection
X-Frame-Options: DENY

# MIME-type sniffing protection
X-Content-Type-Options: nosniff

# Referrer policy
Referrer-Policy: strict-origin-when-cross-origin

# HSTS - enforce HTTPS for 1 year
Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Content Security Policy
Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://wa.me https://fonts.googleapis.com https://fonts.gstatic.com; frame-ancestors 'none'; base-uri 'self'

# Permissions policy
Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
